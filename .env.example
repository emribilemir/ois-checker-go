# OIS Checker Configuration

# University Access
UNIVERSITY_URL=https://ois.uni.edu.tr
UNIVERSITY_USER=YOUR_USERNAME_HERE
UNIVERSITY_PASS=YOUR_PASSWORD_HERE

# Telegram Bot Notification
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Settings
POLL_INTERVAL_SECONDS=300
STATE_FILE=/data/state.json
DERS_SECME_ACTIVE=true
# Comma-separated read-only elective pool paths. The default follows the observed Bölüm Seçmeli pool.
ELECTIVE_POOL_PATHS=/ogrenciler/derssecme/popderssecme/havuz_id/319/ogrenci_slot_id/555925
